# ── Paritok proxy (REQUIRED) ──────────────────────────────────────────────────
# All LLM calls are routed through Paritok. Set this to your Paritok instance.
# Self-hosted default: http://localhost:9000/v1
# Hosted endpoint: check paritok.com for your URL
PARITOK_URL=http://localhost:9000/v1

# ── OpenAI API key ────────────────────────────────────────────────────────────
# Forwarded through Paritok to the upstream LLM provider.
OPENAI_API_KEY=sk-your-openai-key-here

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL=gpt-4o

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set to "true" to use canned mock data (no API key needed, reliable for demos).
# Set to "false" to use live LLM calls through Paritok.
MOCK_MODE=true
